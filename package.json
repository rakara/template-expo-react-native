{
  "name": "template-expo-react-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.87.0",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.1.3",
    "jest-expo": "~58.0.12",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
